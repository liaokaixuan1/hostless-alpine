#!/bin/sh
# busybox httpd CGI：返回运行时探针 JSON
set -e
ALPINE="$(cat /etc/alpine-release 2>/dev/null || echo unknown)"
UP="$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || echo 0)"
NOW="$(date -Iseconds 2>/dev/null || date)"
HOST="$(hostname 2>/dev/null || echo unknown)"
MEM="$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)"

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n'
printf '\r\n'
printf '{"ok":true,"alpine":"%s","uptime_s":%s,"now":"%s","hostname":"%s","mem_total_mib":%s,"port":"%s"}\n' \
  "$ALPINE" "$UP" "$NOW" "$HOST" "$MEM" "${PORT:-8080}"